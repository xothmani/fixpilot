# Settings for FixPilot. These are ENVIRONMENT VARIABLES: export them in your shell.
# Never write a real API key into this file or any other file.

# --- Sandbox limits (all optional, these are the defaults)
FIXPILOT_SANDBOX_IMAGE=fixpilot-sandbox:latest
FIXPILOT_SANDBOX_MEMORY=512m
FIXPILOT_SANDBOX_CPUS=1.0
FIXPILOT_SANDBOX_PIDS=128
FIXPILOT_SANDBOX_TIMEOUT=60
FIXPILOT_SANDBOX_MAX_OUTPUT=6000

# --- Run limits, the same for every provider (all optional, these are the defaults)
# FIXPILOT_MAX_ATTEMPTS=4          # the experiment forces 1 (single pass)
# FIXPILOT_MAX_TOOL_CALLS=25
# FIXPILOT_TIMEOUT_S=300
# FIXPILOT_MAX_TOKENS=200000
# FIXPILOT_MAX_COST_USD=0.25       # per run. "none" switches the cost cap off (then no price is needed)
# FIXPILOT_EXPERIMENT_COST_CAP_USD=  # total for a whole experiment

# --- Model: choose the provider and model (the key goes in your shell, not here)
# FIXPILOT_LLM_PROVIDER=fake            # fake (free, invented answers) | anthropic | openai_compat
# FIXPILOT_MODEL=
# FIXPILOT_LLM_BASE_URL=                # required for openai_compat
# export FIXPILOT_LLM_API_KEY=...       # type this in your terminal only. Not needed for fake or localhost.

# --- Prices in dollars per million tokens. Required whenever a cost cap is active (0 is fine for local).
# FIXPILOT_PRICE_INPUT_PER_MTOK=
# FIXPILOT_PRICE_OUTPUT_PER_MTOK=
# FIXPILOT_PRICE_CACHE_READ_PER_MTOK=   # only with FIXPILOT_PROMPT_CACHE=1
# FIXPILOT_PRICE_CACHE_WRITE_PER_MTOK=

# --- Optional model settings
# FIXPILOT_PROMPT_CACHE=1               # anthropic only
# FIXPILOT_EFFORT=medium                # anthropic only: low | medium | high | xhigh | max
# FIXPILOT_MAX_OUTPUT_TOKENS=4096
# FIXPILOT_LLM_TIMEOUT_S=120
# FIXPILOT_TEMPERATURE=                 # leave unset unless the model allows it
# FIXPILOT_OPENAI_MAX_TOKENS_PARAM=max_tokens   # or max_completion_tokens for some OpenAI models
# FIXPILOT_FAKE_PROFILE=mixed           # fake only: oracle | lost | looper | spender | refuser | chatty | mixed
